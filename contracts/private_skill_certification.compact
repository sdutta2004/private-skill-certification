pragma language_version >= 0.20;
import CompactStandardLibrary;

// ─── Ledger State (8 Public Fields) ──────────────────────────────────────────
export ledger certificateCount: Counter;              // Total certificates issued
export ledger revokedCount: Counter;                  // Total certificates revoked
export ledger activeSession: Counter;                 // Monotonic session epoch nonce (anti-replay)
export ledger skillId: Bytes<32>;                     // Current active skill program identifier
export ledger issuerCommitment: Bytes<32>;            // Issuer root public key commitment anchor
export ledger lastCertificationCommitment: Bytes<32>; // Most recent issued ZK commitment hash
export ledger lastRevokedCommitment: Bytes<32>;       // Most recent revoked commitment hash
export ledger certificationThreshold: Uint<32>;      // Minimum passing score threshold set by issuer

// ─── Witnesses (5 Private Inputs — Never Disclosed On-Chain) ──────────────────
witness candidateSecretKey(): Bytes<32>;        // Candidate private secret salt
witness scoreProofNonce(): Bytes<32>;           // Ephemeral blinding entropy nonce for commitment
witness certificationRecordHash(): Bytes<32>;    // SHA-256 cryptographic hash of exam transcript
witness candidateScoreProof(): Uint<32>;        // Candidate private score value (verified vs threshold)
witness issuerSigningKey(): Bytes<32>;          // Issuer administrative signing key

// ─── Circuit 1: issueCertificate ──────────────────────────────────────────────
// Candidate privately proves score >= certificationThreshold and binds candidate key,
// single-use nonce, transcript hash, and session binding into the ZK commitment.
export circuit issueCertificate(expectedSkillId: Bytes<32>): Bytes<32> {
  assert(skillId == expectedSkillId, "Skill program ID mismatch: certification rejected");

  const candidateKey = candidateSecretKey();
  const nonce = scoreProofNonce();
  const certRecord = certificationRecordHash();
  const candidateScore = candidateScoreProof();

  // ZK Score Threshold Assertion
  assert(candidateScore >= certificationThreshold, "Score below certification threshold: proof rejected");
  assert(nonce != [0; 32], "Invalid score proof nonce: non-zero nonce required");

  // Derive unique session binding incorporating nonce and epoch domain tag
  const sessionNonceBinding = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "psc:session:binding:v2"),
    nonce
  ]);

  // Compute multi-input ZK commitment hash binding candidate identity, nonce, record, and session
  const certificationCommitment = persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "psc:skill:certification:v2"),
    candidateKey,
    nonce,
    certRecord,
    sessionNonceBinding
  ]);

  certificateCount.increment(1);
  activeSession.increment(1);

  const disclosedCommitment = disclose(certificationCommitment);
  lastCertificationCommitment = disclosedCommitment;

  return disclosedCommitment;
}

// ─── Circuit 2: verifyCertificate ─────────────────────────────────────────────
// Verifies whether a claimed commitment matches the on-chain stored commitment.
export circuit verifyCertificate(claimedCommitment: Bytes<32>): Boolean {
  const matches = (claimedCommitment == lastCertificationCommitment);
  return disclose(matches);
}

// ─── Circuit 3: revokeCertificate ─────────────────────────────────────────────
// Authorized issuer revokes a specific certification commitment.
export circuit revokeCertificate(commitmentToRevoke: Bytes<32>): Bytes<32> {
  const issuerKey = issuerSigningKey();
  const derivedIssuerCommitment = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "psc:issuer:authority:v1"),
    issuerKey
  ]);
  assert(derivedIssuerCommitment == issuerCommitment, "Unauthorized: issuer commitment mismatch");

  revokedCount.increment(1);
  activeSession.increment(1);

  const disclosedRevoked = disclose(commitmentToRevoke);
  lastRevokedCommitment = disclosedRevoked;

  return disclosedRevoked;
}

// ─── Circuit 4: setIssuerCommitment ───────────────────────────────────────────
// One-time setup: anchors the issuer's public key commitment and score threshold.
// Subsequent re-keying is blocked to ensure one-time authority anchoring.
export circuit setIssuerCommitment(newThreshold: Uint<32>): Bytes<32> {
  const issuerKey = issuerSigningKey();
  assert(issuerKey != [0; 32], "Invalid issuer signing key");

  const newIssuerCommitment = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "psc:issuer:authority:v1"),
    issuerKey
  ]);

  // Enforce one-time initialization: must not already be anchored
  assert(issuerCommitment == [0; 32], "Unauthorized: issuer already initialized (one-time initialization only)");

  const disclosedCommitment = disclose(newIssuerCommitment);
  issuerCommitment = disclosedCommitment;
  certificationThreshold = newThreshold;
  activeSession.increment(1);

  return disclosedCommitment;
}

// ─── Circuit 5: resetCertification ────────────────────────────────────────────
// Authorized issuer resets the active skill program ID and updates the score threshold.
export circuit resetCertification(newSkillId: Bytes<32>, newThreshold: Uint<32>): Bytes<32> {
  const issuerKey = issuerSigningKey();
  const derivedIssuerCommitment = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "psc:issuer:authority:v1"),
    issuerKey
  ]);
  assert(derivedIssuerCommitment == issuerCommitment, "Unauthorized: issuer authority required to reset");

  skillId = disclose(newSkillId);
  certificationThreshold = newThreshold;
  activeSession.increment(1);

  return skillId;
}

// ─── Circuit 6: incrementSession ──────────────────────────────────────────────
// Issuer-authorized policy: bumps session counter to invalidate stale proofs.
export circuit incrementSession(): [] {
  const issuerKey = issuerSigningKey();
  const derivedIssuerCommitment = persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "psc:issuer:authority:v1"),
    issuerKey
  ]);
  assert(derivedIssuerCommitment == issuerCommitment, "Unauthorized: issuer authority required to increment session");

  activeSession.increment(1);
}
